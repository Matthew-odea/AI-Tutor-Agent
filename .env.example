# .env.example - Template for environment variables (no secrets)

# ================================
# AWS Credentials
# ================================
# Working on DynamoDB only (chat, history, auth, assessments)? You do not need an
# AWS account: run DynamoDB Local (see below) and put any non-empty string here.
# Bedrock, S3, SQS and SES do need real credentials.
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1

# ================================
# AWS Bedrock - AI Models
# ================================
# These are the code defaults and what production runs. Bedrock lives in us-east-1.
BEDROCK_MODEL_CHAT=amazon.nova-lite-v1:0
BEDROCK_MODEL_EMBED=amazon.titan-embed-text-v2:0
BEDROCK_EMBED_DIM=1024
# Do not change BEDROCK_MODEL_EMBED against a shared Neo4j instance. Embeddings from a
# different model are not searchable against existing vectors even at the same dimension,
# so mixing them silently corrupts RAG results rather than failing.
# Model for the cohort report narrative. Runs once per report (~once per 10
# submissions) rather than per answer, so a stronger/pricier model is affordable
# here than on the evaluation path. Falls back to BEDROCK_MODEL_CHAT if unset.
# BEDROCK_MODEL_REPORT=
# Per-answer marking model. Falls back to BEDROCK_MODEL_CHAT. Pin it in prod so a
# chat-model upgrade doesn't change how answers are scored mid-term.
# BEDROCK_MODEL_EVAL=amazon.nova-lite-v1:0

# Bedrock Settings
AGENTCORE_MAX_ATTEMPTS=3
AGENTCORE_BACKOFF=1.5
AGENTCORE_TIMEOUT=30

# ================================
# Logging
# ================================
LOG_LEVEL=INFO
# LOG_FORMAT=json  # Set to "json" in production for structured CloudWatch logs; default is "text" for local dev

# ================================
# DynamoDB - Session Persistence
# ================================
DYNAMODB_TABLE_NAME=chat_sessions
DYNAMODB_ASSESSMENT_TABLE=oral_assessments
DYNAMODB_REGION=us-east-1

# Local development: DynamoDB Local instead of an AWS account.
# `docker-compose up -d` starts it on host port 8001 and creates the three tables.
# Uncomment the line below and the app reads and writes there instead of AWS.
# (`docker-compose down -v` wipes the data; re-create the tables with
#  AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8001 python scripts/dynamodb_local_bootstrap.py)
# AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8001
# If the api itself runs in docker-compose, use the in-network address instead:
# COMPOSE_DYNAMODB_ENDPOINT=http://dynamodb-local:8000

# Auth runtime configuration
AUTH_JWT_SECRET=replace_with_a_long_random_secret
DYNAMODB_AUTH_USERS_TABLE=auth_users
AUTH_ACCESS_TOKEN_MINUTES=60
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_web_client_id
AUTH_PASSWORD_RESET_TOKEN_MINUTES=30
AUTH_PASSWORD_RESET_BASE_URL=http://localhost:5173/?reset=1
AUTH_PASSWORD_RESET_FROM_EMAIL=noreply@example.com
AUTH_PASSWORD_RESET_SES_REGION=us-east-1
# Used for student assessment reminder emails; falls back to AUTH_PASSWORD_RESET_FROM_EMAIL if unset
INVITE_FROM_EMAIL=assessments@example.com

# Queue backing question generation and batch evaluation jobs
SQS_JOBS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/ai-tutor-jobs
# Bucket holding assessment audio recordings and proctoring footage
S3_ASSESSMENT_BUCKET=your-assessment-bucket

# ================================
# Deepgram - Speech-to-Text (Optional)
# ================================
DEEPGRAM_SECRET_KEY=your_deepgram_api_key

# ================================
# CORS - Frontend Configuration
# ================================
# Comma-separated list of allowed browser origins. There is no default: if this
# is unset the API accepts no cross-origin requests at all, so local dev needs it.
ALLOW_ORIGINS=http://localhost:5173,http://localhost:5175,http://localhost:5176

# ================================
# Neo4j - Vector Store for Context
# ================================
NEO4J_URI=bolt://3.27.56.110:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=your_database_id
AURA_INSTANCEID=your_instance_id
AURA_INSTANCENAME=Instance name

# ================================
# Ed Platform (UNSW-specific, optional)
# ================================
ED_BEARER=your_ed_bearer_token

